# Application
APP_NAME=Personal AI Assistant
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
API_DOCS_ENABLED=true

# Database. Use PostgreSQL with pgvector outside tests.
DATABASE_URL=postgresql+psycopg2://personal_ai:replace_me@localhost:5432/personal_ai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STARTUP_RETRY_ATTEMPTS=5
DB_STARTUP_RETRY_DELAY_SECONDS=2

# Model providers. OpenAI is required for the default provider and embeddings.
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
XAI_API_KEY=
XAI_MODEL=grok-2-latest
MODEL_PROVIDER_DEFAULT=openai
MODEL_COLLABORATION_ENABLED=false

# Authentication. In production, use at least 32 random characters.
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# HTTP security and logging.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Uploads.
MAX_UPLOAD_BYTES=10485760
